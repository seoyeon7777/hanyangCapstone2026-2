<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/filterDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 상단 제목과 닫기 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="필터"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#111111"/>

        <TextView
            android:id="@+id/btnFilterClose"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="×"
            android:textSize="26sp"
            android:textColor="#111111"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E7E7E7"/>

    <!-- 가운데 내용만 스크롤 -->
    <ScrollView
        android:id="@+id/filterScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="none"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- 가격 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="가격"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#111111"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/editFilterMinPrice"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_filter_input"
                    android:gravity="center"
                    android:hint="최소 금액"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textSize="12sp"
                    android:textColor="#111111"
                    android:textColorHint="#999999"
                    android:padding="8dp"/>

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="~"
                    android:textSize="14sp"
                    android:textColor="#777777"/>

                <EditText
                    android:id="@+id/editFilterMaxPrice"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_filter_input"
                    android:gravity="center"
                    android:hint="최대 금액"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textSize="12sp"
                    android:textColor="#111111"
                    android:textColorHint="#999999"
                    android:padding="8dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="12dp"
                android:background="#E7E7E7"/>

            <!-- 색상 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="색상"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#111111"/>

            <LinearLayout
                android:id="@+id/filterColorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:background="#E7E7E7"/>

            <!-- 스타일 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="스타일"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#111111"/>

            <LinearLayout
                android:id="@+id/filterStyleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:background="#E7E7E7"/>

            <!-- 키 / 몸무게 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="키 / 몸무게"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#111111"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editFilterHeight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_filter_input"
                    android:gravity="center"
                    android:hint="키 (cm)"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:textSize="12sp"
                    android:textColor="#111111"
                    android:textColorHint="#999999"
                    android:padding="8dp"/>

                <EditText
                    android:id="@+id/editFilterWeight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_filter_input"
                    android:gravity="center"
                    android:hint="몸무게 (kg)"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:textSize="12sp"
                    android:textColor="#111111"
                    android:textColorHint="#999999"
                    android:padding="8dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="12dp"
                android:background="#E7E7E7"/>

            <!-- 체형 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="체형"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#111111"/>

            <LinearLayout
                android:id="@+id/filterBodyTypeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>

        </LinearLayout>
    </ScrollView>

    <!-- 하단 고정 버튼 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E7E7E7"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/btnFilterReset"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:background="#EEEEEE"
            android:text="초기화"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:clickable="true"/>

        <TextView
            android:id="@+id/btnFilterApply"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="2"
            android:gravity="center"
            android:background="#111111"
            android:text="상품 보기"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:clickable="true"/>
    </LinearLayout>

</LinearLayout>
