<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnSearchBack"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="32sp"
            android:textColor="#111111"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F4F4F4"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <EditText
                android:id="@+id/editSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="상품명 또는 브랜드 검색"
                android:textSize="14sp"
                android:textColor="#111111"
                android:textColorHint="#AAAAAA"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:importantForAutofill="no"/>

            <TextView
                android:id="@+id/btnClearSearch"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="×"
                android:textSize="22sp"
                android:textColor="#777777"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/textResultCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="검색 결과 0개"
            android:textColor="#333333"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/btnSearchFilter"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="☷  필터"
            android:textSize="14sp"
            android:textColor="#222222"/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp"/>

        <TextView
            android:id="@+id/textSearchEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="검색 결과가 없습니다.\n다른 검색어를 입력해주세요."
            android:textSize="15sp"
            android:textColor="#999999"
            android:lineSpacingExtra="8dp"
            android:visibility="gone"/>

    </FrameLayout>

    <include layout="@layout/view_bottom_menu"/>

</LinearLayout>
