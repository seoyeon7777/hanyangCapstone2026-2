<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutLoginRequired"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:visibility="gone">

    <!-- 이전 화면으로 (상품 상세 상단바와 같은 화살표). 필요한 화면만 LoginRequiredView.showBack으로 켠다 -->
    <TextView
        android:id="@+id/btnLoginRequiredBack"
        android:layout_width="40dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:gravity="center"
        android:text="‹"
        android:textColor="#111111"
        android:textSize="36sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/imgLoginRequired"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="14dp"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="로그인이 필요해요"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textLoginRequired"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#888888"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnLoginRequired"
            android:layout_width="180dp"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_dialog_btn_dark"
            android:gravity="center"
            android:text="로그인하기"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
