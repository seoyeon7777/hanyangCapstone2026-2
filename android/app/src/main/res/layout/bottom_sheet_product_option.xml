<?xml version="1.0" encoding="utf-8"?>

<!-- ========================= -->
<!-- 상품 옵션 선택 창 -->
<!-- 장바구니 담기 / 3D 가상피팅 전에 -->
<!-- 아래에서 올라온다 -->
<!-- ========================= -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">


    <!-- 손잡이 -->

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_option_handle" />


    <!-- 상품명 -->

    <TextView
        android:id="@+id/textOptionProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="오버핏 반팔 티셔츠"
        android:textColor="#111111"
        android:textSize="17sp"
        android:textStyle="bold" />


    <!-- ========================= -->
    <!-- 사이즈 -->
    <!-- ========================= -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="사이즈"
        android:textColor="#111111"
        android:textSize="15sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/groupOptionSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp" />


    <!-- ========================= -->
    <!-- 색상 -->
    <!-- ========================= -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="색상"
        android:textColor="#111111"
        android:textSize="15sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/groupOptionColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp" />


    <!-- 구분선 -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="22dp"
        android:background="#EEEEEE" />


    <!-- ========================= -->
    <!-- 선택한 옵션 + 수량 -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textOptionSelected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="옵션을 선택해주세요"
            android:textColor="#888888"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnQtyMinus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_option_row"
            android:gravity="center"
            android:text="−"
            android:textColor="#111111"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textQty"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textColor="#111111"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnQtyPlus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_option_row"
            android:gravity="center"
            android:text="+"
            android:textColor="#111111"
            android:textSize="18sp" />

    </LinearLayout>


    <!-- ========================= -->
    <!-- 총 금액 -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="총 상품 금액"
            android:textColor="#555555"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textOptionTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10,000원"
            android:textColor="#111111"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ========================= -->
    <!-- 확인 버튼 -->
    <!-- ========================= -->

    <TextView
        android:id="@+id/btnOptionConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_dialog_btn_dark"
        android:gravity="center"
        android:text="장바구니 담기"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
