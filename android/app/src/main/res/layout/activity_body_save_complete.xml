<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_circle_black"
            android:src="@drawable/ic_check"
            android:contentDescription="저장 완료"
            android:padding="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="내 체형 정보가 저장되었습니다"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvSavedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#555555"
            android:textSize="15sp"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/btnGoMyBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView
                android:id="@+id/tvGoMyBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="저장한 체형 정보는 마이페이지에서 확인할 수 있어요"
                android:textColor="#666666"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_right"
                android:tint="#666666" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/btnFeedback"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_dialog_btn_dark"
        android:gravity="center"
        android:text="피드백 확인하기"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnGoHome"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dialog_btn_light"
        android:gravity="center"
        android:text="메인 홈 가기"
        android:textColor="#111111"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
