<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/view_mypage_toolbar" />

    <ScrollView
        android:id="@+id/scrollNotice"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ============ 고객센터 ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_info_box"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/MyPageSubText"
                    android:text="고객센터"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvCsPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="1588-0000"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/MyPageSubText"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="평일 10:00 ~ 18:00 (점심 12:00 ~ 13:00)\n주말 및 공휴일 휴무"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCall"
                        style="@style/MyPageButtonSmall"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="전화 상담" />

                    <Button
                        android:id="@+id/btnInquiry"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="1:1 문의하기"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 탭 ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tabNotice"
                        style="@style/MyPageTab"
                        android:text="공지사항" />

                    <View
                        android:id="@+id/lineNotice"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/black" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tabFaq"
                        style="@style/MyPageTab"
                        android:text="자주 묻는 질문" />

                    <View
                        android:id="@+id/lineFaq"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/black"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />

            <!-- ============ FAQ 카테고리 (메인 화면 카테고리와 같은 형식, FAQ 탭에서만 보임) ============ -->
            <HorizontalScrollView
                android:id="@+id/scrollFaqCategory"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:scrollbars="none"
                android:visibility="gone">

                <!-- 카테고리 TextView는 NoticeActivity에서 채운다 -->
                <LinearLayout
                    android:id="@+id/containerFaqCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />
            </HorizontalScrollView>

            <!-- item_notice.xml 항목이 Java에서 채워진다 (notices / faqs) -->
            <LinearLayout
                android:id="@+id/containerNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp" />

            <TextView
                android:id="@+id/tvEmpty"
                style="@style/MyPageEmpty"
                android:text="등록된 글이 없습니다." />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
