<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="체형 자가진단 결과"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:gravity="center"
            android:text="나의 골격 체형은"
            android:textColor="#888888"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="스트레이트 체형"
            android:textColor="#000000"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="48dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:layout_marginTop="18dp"
            android:background="#000000"/>

        <TextView
            android:id="@+id/resultDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="체형 요약"
            android:textColor="#333333"
            android:textSize="16sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="#F7F7F7"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이런 특징이 있어요"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/resultFeatures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="12dp"
                android:text="• 특징"
                android:textColor="#444444"
                android:textSize="14sp"/>

            <ImageView
                android:id="@+id/imgSurveyType"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="16dp"
                android:scaleType="fitCenter"
                android:background="#F4F4F4"
                android:contentDescription="체형 대표 이미지"/>

            <TextView
                android:id="@+id/btnSurveyFeedback"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:text="내 체형 스타일 피드백 자세히 보기 →"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="#111111"/>
        </LinearLayout>

        <TextView
            android:id="@+id/resultNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="설문 응답을 바탕으로 한 참고용 결과예요.&#10;정밀 측정을 하면 더 정확해져요."
            android:textColor="#999999"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/resultGuestNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="결과는 저장되지 않아요.&#10;로그인해야 내 체형으로 저장돼요."
            android:textColor="#E5542F"
            android:textSize="13sp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button_outlin"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_refresh"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="다시 검사하기"
                android:textColor="#333333"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="#F7F7F7"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="이 결과를 어떻게 할까요?"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="전신 사진(정면·옆면)을 올리면 치수까지 더 자세하게 분석해요.&#10;사진 없이 지금 결과만 내 체형으로 저장할 수도 있어요."
                android:textColor="#777777"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnYes"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#111111"
                android:text="사진으로 정밀 분석하기"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnSaveSurvey"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#EAEAEA"
                android:text="이대로 저장하기"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnNo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="저장하지 않고 나가기"
                android:textColor="#777777"
                android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
