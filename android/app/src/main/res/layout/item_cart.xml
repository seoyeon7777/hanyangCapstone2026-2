<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cbCartSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:buttonTint="#111111"
            android:contentDescription="상품 선택"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <FrameLayout
            android:layout_width="105dp"
            android:layout_height="130dp"
            android:background="#F3F3F3">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="상품 이미지"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textCartBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="브랜드"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <TextView
                android:id="@+id/textCartProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="상품명"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/textCartOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="M / BLACK"
                android:textSize="12sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/textCartPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="10,000원"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#111111" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F5F5F5">

            <TextView
                android:id="@+id/btnMinus"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="−"
                android:textSize="20sp"
                android:textColor="#111111" />

            <TextView
                android:id="@+id/textQuantity"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1"
                android:textSize="14sp"
                android:textColor="#111111" />

            <TextView
                android:id="@+id/btnPlus"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textSize="20sp"
                android:textColor="#111111" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnChangeOption"
            android:layout_width="72dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="옵션 변경"
            android:textSize="13sp"
            android:textColor="#111111"
            android:background="#F5F5F5" />

        <TextView
            android:id="@+id/btnDeleteCart"
            android:layout_width="60dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="삭제"
            android:textSize="13sp"
            android:textColor="#777777"
            android:background="#F5F5F5" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#EEEEEE" />

</LinearLayout>
