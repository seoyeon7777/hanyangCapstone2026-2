<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/view_mypage_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProfileCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="저장된 체형 0개"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:padding="4dp"
                    android:text="전체 선택"
                    android:textColor="#5A5A5A"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvSelectMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:padding="4dp"
                    android:text="선택삭제"
                    android:textColor="#111111"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNewMeasure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="새로 측정 ›"
                    android:textColor="#5A5A5A"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                style="@style/MyPageSubText"
                android:layout_marginBottom="12dp"
                android:text="대표 체형은 장바구니·주문 시 사이즈 확인에 사용돼요."
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/layoutProfiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvEmptyProfiles"
                style="@style/MyPageEmpty"
                android:paddingVertical="40dp"
                android:text="저장된 체형 정보가 없어요.&#10;체형 분석에서 체형을 측정해 보세요." />

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginHorizontal="-20dp"
                android:layout_marginTop="8dp"
                android:background="#F5F5F5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="체형 설정"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAll"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="전체 설정 한 번에 켜기/끄기"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSizeWarning"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="사이즈 경고 팝업 켜기"
                    android:textColor="#333333"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMeasureNotice"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="측정 권유 팝업 켜기"
                    android:textColor="#333333"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoActive"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="새 체형 대표 자동 설정 켜기"
                    android:textColor="#333333"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/btnMeasureNew"
        style="@style/MyPageButtonPrimary"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:text="선택 삭제"
        android:visibility="gone" />

</LinearLayout>
