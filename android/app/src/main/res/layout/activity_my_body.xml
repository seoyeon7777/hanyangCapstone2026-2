<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/view_mypage_toolbar" />

    <!-- 비로그인이면 이 안내만 보이고 아래 내용은 숨김 (LoginRequiredView, 찜 화면과 같음) -->
    <include
        layout="@layout/view_login_required"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ScrollView
        android:id="@+id/scrollMyBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProfileCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="저장된 체형 0개"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:padding="4dp"
                    android:text="전체 선택"
                    android:textColor="#5A5A5A"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvSelectMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:padding="4dp"
                    android:text="선택삭제"
                    android:textColor="#111111"
                    android:textSize="12sp"
                    android:textStyle="bold" />



            </LinearLayout>

            <TextView
                style="@style/MyPageSubText"
                android:layout_marginBottom="12dp"
                android:text="체형을 여러 개 저장하고 하나를 현재 체형으로 고를 수 있어요. 현재 체형은 홈 골격 맞춤 추천과 장바구니·주문 사이즈 확인에 쓰여요."
                android:textSize="12sp" />

            <!-- 새 체형 추가하기: 키·몸무게·나이 → 설문 → (선택) 사진 정밀 분석 (FittingActivity) -->
            <Button
                android:id="@+id/tvNewMeasure"
                style="@style/MyPageButtonPrimary"
                android:layout_marginBottom="14dp"
                android:text="+ 새 체형 추가하기" />

            <LinearLayout
                android:id="@+id/layoutProfiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvEmptyProfiles"
                style="@style/MyPageEmpty"
                android:paddingVertical="40dp"
                android:text="저장된 체형 정보가 없어요.&#10;'새 체형 추가하기'로 체형을 분석해 보세요." />

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginHorizontal="-20dp"
                android:layout_marginTop="8dp"
                android:background="#F5F5F5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="체형 설정"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAll"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="전체 사용"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:thumbTint="#000000"
                    app:trackTint="#BBBBBB" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <!-- 제목 + 회색 설명. 줄 어디를 눌러도 스위치가 바뀜 (MyBodyActivity) -->
                <LinearLayout
                    android:id="@+id/rowSizeWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="사이즈 경고 팝업"
                            android:textColor="#333333"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="선택한 사이즈가 체형과 맞지 않을 때 알려드려요"
                            android:textColor="#999999"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSizeWarning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="#000000"
                        app:trackTint="#BBBBBB" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMeasureNotice"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="측정 권유 팝업"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    app:thumbTint="#000000"
                    app:trackTint="#BBBBBB" />

                <!-- 제목 + 회색 설명. 줄 어디를 눌러도 스위치가 바뀜 (MyBodyActivity) -->
                <LinearLayout
                    android:id="@+id/rowAutoActive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="새 체형을 현재 체형으로 자동 선택"
                            android:textColor="#333333"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="체형을 저장하면 자동으로 현재 체형이 바뀌어요"
                            android:textColor="#999999"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAutoActive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="#000000"
                        app:trackTint="#BBBBBB" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/btnMeasureNew"
        style="@style/MyPageButtonPrimary"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:text="선택 삭제"
        android:visibility="gone" />

    <include layout="@layout/view_bottom_menu" />

</LinearLayout>
