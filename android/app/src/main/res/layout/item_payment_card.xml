<?xml version="1.0" encoding="utf-8"?>
<!-- 등록 카드 1장 (payments) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCompany"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="신한카드"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDefaultBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_black"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="기본결제"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCardNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:letterSpacing="0.08"
        android:text="**** **** **** 1234"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvExpiry"
        style="@style/MyPageSubText"
        android:layout_marginTop="4dp"
        android:text="유효기간 12/28"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSetDefault"
            style="@style/MyPageButtonSmall"
            android:layout_marginEnd="8dp"
            android:text="기본으로 설정" />

        <Button
            android:id="@+id/btnDelete"
            style="@style/MyPageButtonSmall"
            android:text="삭제" />
    </LinearLayout>

</LinearLayout>
