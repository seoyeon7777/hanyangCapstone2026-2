<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 상단 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_back"
                android:textColor="#222222"
                android:textSize="32sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="주문/결제"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="40dp"
                android:layout_height="40dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE" />

        <!-- 주문 상품 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="주문 상품"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:text="상품명"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProductOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:paddingHorizontal="16dp"
            android:text="옵션: M / Black"
            android:textColor="#777777"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvProductQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:paddingHorizontal="16dp"
            android:text="수량: 1개"
            android:textColor="#777777"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvProductPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="16dp"
            android:text="29,900원"
            android:textColor="#111111"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="20dp"
            android:background="#F5F5F5" />

        <!-- 배송지 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="배송지"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnChangeAddress"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_button_small_outline"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="변경"
                android:textColor="#111111"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/containerAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp" />

        <!-- 주문 시 선택하는 배송 요청사항 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:text="배송 요청사항"
            android:textColor="#111111"
            android:textSize="15sp"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/spOrderRequest"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_edit" />

        <EditText
            android:id="@+id/etOrderRequest"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_edit"
            android:hint="배송 요청사항을 직접 입력해 주세요 (50자 이내)"
            android:inputType="text"
            android:maxLength="50"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/btnAddAddress"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_add_card_dashed"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#111111"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="배송지 등록"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="20dp"
            android:background="#F5F5F5" />

        <!-- 결제 방법 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="결제 방법"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">

            <RadioButton
                android:id="@+id/rbCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:buttonTint="#111111"
                android:checked="true"
                android:text="신용/체크카드"
                android:textColor="#111111"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/rbBank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:buttonTint="#111111"
                android:text="계좌이체"
                android:textColor="#111111"
                android:textSize="15sp" />

        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="20dp"
            android:background="#F5F5F5" />

        <!-- 쿠폰 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="쿠폰"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCouponSelected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="사용 안 함"
                    android:textColor="#777777"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSelectCoupon"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_button_small_outline"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="쿠폰 선택"
                android:textColor="#111111"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/containerCoupon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:background="#F5F5F5" />

        <!-- 결제 금액 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="결제 금액"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="상품 금액"
                android:textColor="#555555"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvOrderPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="29,900원"
                android:textColor="#222222"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="쿠폰 할인"
                android:textColor="#555555"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvCouponDiscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0원"
                android:textColor="#222222"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="배송비"
                android:textColor="#555555"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvDeliveryPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="무료"
                android:textColor="#222222"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="총 결제금액"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="29,900원"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 주문 버튼 -->
        <Button
            android:id="@+id/btnOrder"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="16dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#111111"
            android:textColor="#FFFFFF"
            android:text="29,900원 결제하기"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>