<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 상단 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnCategoryBack"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#111111"
            android:textSize="32sp"
            android:contentDescription="뒤로가기"/>

        <TextView
            android:id="@+id/textCategoryTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="상의"
            android:textColor="#111111"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnCategorySearch"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⌕"
            android:textColor="#111111"
            android:textSize="30sp"
            android:contentDescription="검색"/>
    </LinearLayout>

    <!-- 세부 카테고리 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="51dp"
        android:scrollbars="none"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/categoryChipContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </HorizontalScrollView>

    <!-- 필터 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="49dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/categoryFilterContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"/>

    <!-- 상품 수와 정렬 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="47dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/textCategoryCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="상품 0개"
            android:textColor="#666666"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/btnCategorySort"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:text="추천순⌄"
            android:textColor="#333333"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- 상품 목록 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCategory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp"/>

        <TextView
            android:id="@+id/textCategoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="해당 조건의 상품이 없습니다."
            android:textColor="#888888"
            android:textSize="14sp"
            android:visibility="gone"/>
    </FrameLayout>

    <include layout="@layout/view_bottom_menu"/>

</LinearLayout>
