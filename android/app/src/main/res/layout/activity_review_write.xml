<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/view_mypage_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- ============ 상품 정보 ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_info_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <View
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_thumb" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProductName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="상품명"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOption"
                        style="@style/MyPageSubText"
                        android:layout_marginTop="2dp"
                        android:text="옵션"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 별점 ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:text="상품은 만족하셨나요?"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RatingBar
                android:id="@+id/ratingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:numStars="5"
                android:progressTint="#111111"
                android:rating="0"
                android:stepSize="1" />

            <TextView
                android:id="@+id/tvRatingLabel"
                style="@style/MyPageSubText"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="별점을 선택해주세요" />

            <!-- ============ 내용 ============ -->
            <TextView
                style="@style/MyPageFormLabel"
                android:text="리뷰 내용" />

            <EditText
                android:id="@+id/etContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edit"
                android:gravity="top|start"
                android:hint="사이즈, 핏, 색감 등 솔직한 후기를 남겨주세요. (10자 이상)"
                android:inputType="textMultiLine"
                android:maxLength="500"
                android:minHeight="180dp"
                android:padding="16dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvContentCount"
                style="@style/MyPageSubText"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:text="0 / 500"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSubmit"
        style="@style/MyPageButtonPrimary"
        android:layout_margin="20dp"
        android:text="등록하기" />

</LinearLayout>
