<?xml version="1.0" encoding="utf-8"?>
<!-- 이메일·휴대폰 번호 등록·변경: 입력 → 인증받기 → 인증번호 입력 → 변경 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvContactDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#111111"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvContactDialogDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="#555555"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etDialogContact"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="#111111"
            android:textColorHint="#AAAAAA"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnDialogSendCode"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button"
            android:paddingHorizontal="14dp"
            android:text="인증받기"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <EditText
            android:id="@+id/etDialogCode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit"
            android:hint="인증번호 4자리"
            android:inputType="number"
            android:maxLength="4"
            android:paddingStart="14dp"
            android:paddingEnd="72dp"
            android:singleLine="true"
            android:textColor="#111111"
            android:textColorHint="#AAAAAA"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvDialogTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="18dp"
            android:textColor="#E5542F"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnContactCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn_light"
            android:gravity="center"
            android:text="취소"
            android:textColor="#111111"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnContactOk"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn_dark"
            android:gravity="center"
            android:text="변경"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
