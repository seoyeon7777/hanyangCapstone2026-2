<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- 상단 툴바 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@null"
            android:src="@drawable/ic_back"
            app:tint="@color/black" />

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@null"
            android:src="@drawable/ic_home"
            android:scaleType="fitCenter" />

    </RelativeLayout>

    <!-- 스크롤 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="회원가입"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp" />

            <!-- 아이디 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="아이디"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <EditText
                    android:id="@+id/etId"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="영문, 숫자 포함 8자 이상"
                    android:background="@drawable/bg_edit"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnCheckId"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="중복확인"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_button"
                    app:backgroundTint="@null" />

            </LinearLayout>

            <!-- 비밀번호 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="비밀번호"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etPw"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="영문, 숫자, 특수문자포함 8자 이상"
                    android:background="@drawable/bg_edit"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:textSize="14sp"
                    android:inputType="textPassword" />

                <ImageButton
                    android:id="@+id/btnTogglePw1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:background="@null"
                    android:src="@drawable/ic_eye_off"
                    android:scaleType="fitCenter" />

            </FrameLayout>

            <!-- 비밀번호 재확인 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="비밀번호 재확인"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">

                <EditText
                    android:id="@+id/etPw2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="영문, 숫자, 특수문자포함 8자 이상"
                    android:background="@drawable/bg_edit"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:textSize="14sp"
                    android:inputType="textPassword" />

                <ImageButton
                    android:id="@+id/btnTogglePw"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:background="@null"
                    android:src="@drawable/ic_eye_off"
                    android:scaleType="fitCenter" />

            </FrameLayout>

            <!-- 이름 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이름"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_edit"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:inputType="textPersonName"
                android:layout_marginBottom="20dp" />

            <!-- 생년월일 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="생년월일"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <EditText
                    android:id="@+id/etYear"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="년(4자)"
                    android:background="@drawable/bg_edit"
                    android:paddingHorizontal="16dp"
                    android:textSize="13sp"
                    android:inputType="number"
                    android:maxLength="4"
                    android:layout_marginEnd="8dp" />

                <Spinner
                    android:id="@+id/spMonth"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="8dp" />

                <Spinner
                    android:id="@+id/spDay"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit"
                    android:paddingHorizontal="12dp" />

            </LinearLayout>

            <!-- 성별 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="성별"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spGender"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_edit"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="32dp" />

            <!-- 약관 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="서비스 이용약관에 동의해주세요"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="24dp" />

            <CheckBox
                android:id="@+id/cbAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="전체 동의하기"
                android:textStyle="bold"
                android:paddingBottom="10dp" />

            <CheckBox
                android:id="@+id/cb1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(필수) 서비스 이용약관 동의" />

            <CheckBox
                android:id="@+id/cb2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(필수) 개인정보 수집 및 이용 동의" />

            <CheckBox
                android:id="@+id/cb3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(필수) 만 14세 이상입니다" />

            <CheckBox
                android:id="@+id/cb4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(선택) 마케팅 정보 수신 동의" />

            <CheckBox
                android:id="@+id/cb5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(선택) 이벤트 및 프로모션 알림" />

        </LinearLayout>

    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.1" />

    <!-- 가입하기 -->
    <Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="회원가입"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_button"
        app:backgroundTint="@null" />

</LinearLayout>