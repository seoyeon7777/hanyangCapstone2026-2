<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center"
        android:text="기본 아바타"
        android:textColor="#111111"
        android:textSize="20sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />

    <TextView
        android:id="@+id/tvAvatarInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:text="키에 맞춰 기본 모델을 세팅했습니다. 부위를 눌러 치수를 수정하세요."
        android:textColor="#777777"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/avatarStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F2F2F2">

        <TextureView
            android:id="@+id/viewAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/avatarTouch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/panelMeasure"
            android:layout_width="176dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_measure_card"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPartName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="허리"
                android:textColor="#111111"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/partRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btnFullView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="전체 보기"
                android:textColor="#666666"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="체형"
                android:textColor="#666666"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/bodyTypeRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="마름"
                android:textColor="#999999"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekBodyFat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="80" />

            <TextView
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="통통"
                android:textColor="#999999"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvPartHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:text="부위를 누르면 확대됩니다. 드래그하면 회전합니다."
        android:textColor="#999999"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btnSaveBody"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_dialog_btn_dark"
        android:gravity="center"
        android:text="저장하기"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 공통 하단 메뉴 (view_bottom_menu.xml) -->
    <include layout="@layout/view_bottom_menu" />

</LinearLayout>
