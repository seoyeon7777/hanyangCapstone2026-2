<?xml version="1.0" encoding="utf-8"?>
<!-- 프로필 수정 > 이메일 변경: 주소 입력 → 인증메일 보내기 → 메일 속 링크 클릭 → 인증확인 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="이메일 변경"
        android:textColor="#111111"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="주문 안내와 소식을 받을 이메일이에요."
        android:textColor="#555555"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etEmailId"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit"
            android:hint="이메일"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="14dp"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:text="\@"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- 도메인: 목록에서 고르고, "직접 입력"이면 같은 자리가 입력칸으로 바뀐다 (▾로 목록 다시 열기) -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="48dp">

            <Spinner
                android:id="@+id/spEmailDomain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_edit"
                android:paddingHorizontal="12dp" />

            <EditText
                android:id="@+id/etEmailDomain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_edit"
                android:hint="직접 입력"
                android:inputType="textEmailAddress"
                android:paddingStart="14dp"
                android:paddingEnd="34dp"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnDomainList"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center"
                android:text="▾"
                android:textColor="#777777"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>


    <TextView
        android:id="@+id/btnSendMail"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_small_outline"
        android:gravity="center"
        android:text="인증메일 보내기"
        android:textColor="#111111"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvMailNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:textColor="#888888"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn_light"
            android:gravity="center"
            android:text="취소"
            android:textColor="#111111"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnVerifyEmail"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_gray"
            android:enabled="false"
            android:gravity="center"
            android:text="인증확인"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
