<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/view_mypage_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvAddressCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="배송지 0개"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- item_address.xml 카드가 Java에서 채워진다 (delivery) -->
            <LinearLayout
                android:id="@+id/containerAddresses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvEmpty"
                style="@style/MyPageEmpty"
                android:text="등록된 배송지가 없습니다.\n배송지를 추가해주세요." />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnAddAddress"
        style="@style/MyPageButtonPrimary"
        android:layout_margin="20dp"
        android:text="+ 배송지 추가" />

</LinearLayout>
