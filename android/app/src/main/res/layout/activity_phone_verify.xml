<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@null"
            android:src="@drawable/ic_back"
            app:tint="@color/black"/>

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@null"
            android:src="@drawable/ic_home"
            android:scaleType="fitCenter"/>
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="본인확인"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="본인확인을 위해 인증을 진행해주세요."
        android:textSize="13sp"
        android:textColor="@color/black"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="40dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="휴대폰 번호"
        android:textSize="12sp"
        android:textColor="@color/black"
        android:layout_marginBottom="6dp"/>

    <!-- 010 - XXXX - XXXX : 010은 고정, 나머지 두 칸만 입력 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="010"
            android:background="@drawable/bg_edit"
            android:textColor="#888888"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:text="-"
            android:textColor="@color/black"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/etPhoneMid"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:hint="0000"
            android:background="@drawable/bg_edit"
            android:inputType="number"
            android:maxLength="4"
            android:imeOptions="actionNext"
            android:paddingHorizontal="8dp"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:text="-"
            android:textColor="@color/black"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/etPhoneLast"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:hint="0000"
            android:background="@drawable/bg_edit"
            android:inputType="number"
            android:maxLength="4"
            android:imeOptions="actionDone"
            android:paddingHorizontal="8dp"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnVerify"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="인증받기"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_button"
            app:backgroundTint="@null"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="인증번호"
        android:textColor="@color/black"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etAuthCode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="인증번호를 입력해주세요."
        android:inputType="number"
        android:maxLength="4"
        android:background="@drawable/bg_edit"
        android:paddingHorizontal="16dp"
        android:textSize="14sp"
        android:layout_marginBottom="6dp"/>

    <!-- 문자 발송 기능이 없어서 보낸 인증번호를 화면에 보여 준다 -->
    <TextView
        android:id="@+id/tvAuthCodeNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="12dp"
        android:textColor="#888888"
        android:textSize="11sp"
        android:visibility="gone"/>

    <!-- 누르면 수신차단 확인 안내가 아래에서 올라온다 (밑줄은 코드에서) -->
    <TextView
        android:id="@+id/tvNoAuthCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="12dp"
        android:paddingVertical="4dp"
        android:text="인증번호가 안 와요."
        android:textColor="#888888"
        android:textSize="13sp"/>

    <Button
        android:id="@+id/btnVerifyCode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="다음"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:background="@drawable/bg_button_gray"
        android:enabled="false"
        app:backgroundTint="@null"/>

</LinearLayout>