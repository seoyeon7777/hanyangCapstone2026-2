<?xml version="1.0" encoding="utf-8"?>
<!-- 프로필 수정 > 휴대폰 번호 변경: 새 번호 입력 → 인증번호 받기(안내 창) → 번호 입력 → 인증확인 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="휴대폰 번호 변경"
        android:textColor="#111111"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="새 번호로 인증을 받으면 바뀌어요."
        android:textColor="#555555"
        android:textSize="14sp" />

    <include
        android:id="@+id/layoutPhoneFields"
        layout="@layout/view_phone_fields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp" />

    <TextView
        android:id="@+id/btnSendPhoneCode"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_small_outline"
        android:gravity="center"
        android:text="인증번호 받기"
        android:textColor="#111111"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvPhoneNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:textColor="#888888"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutPhoneCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/etPhoneCode"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit"
            android:hint="인증번호 4자리"
            android:inputType="number"
            android:maxLength="4"
            android:paddingHorizontal="14dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPhoneTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="#E5542F"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPhoneCancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn_light"
            android:gravity="center"
            android:text="취소"
            android:textColor="#111111"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnVerifyPhone"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_gray"
            android:enabled="false"
            android:gravity="center"
            android:text="인증확인"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
