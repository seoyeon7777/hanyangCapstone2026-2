<?xml version="1.0" encoding="utf-8"?>
<!-- 배송지 카드 1건 (delivery) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="집"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDefaultBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_black"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="기본배송지"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvReceiver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="받는 분 · 010-0000-0000"
        android:textColor="@color/black"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvAddress"
        style="@style/MyPageSubText"
        android:layout_width="match_parent"
        android:layout_marginTop="4dp"
        android:text="(00000) 주소 상세주소" />

    <TextView
        android:id="@+id/tvRequest"
        style="@style/MyPageSubText"
        android:layout_marginTop="4dp"
        android:text="요청사항"
        android:textColor="#888888"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSetDefault"
            style="@style/MyPageButtonSmall"
            android:layout_marginEnd="8dp"
            android:text="기본으로 설정" />

        <Button
            android:id="@+id/btnEdit"
            style="@style/MyPageButtonSmall"
            android:layout_marginEnd="8dp"
            android:text="수정" />

        <Button
            android:id="@+id/btnDelete"
            style="@style/MyPageButtonSmall"
            android:text="삭제" />
    </LinearLayout>

</LinearLayout>
