<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/view_mypage_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- ============ 비밀번호 변경 ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="비밀번호 변경"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/MyPageSubText"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="변경하지 않으려면 비워두세요."
                android:textSize="12sp" />

            <TextView
                style="@style/MyPageFormLabel"
                android:text="현재 비밀번호" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp">

                <EditText
                    android:id="@+id/etCurrentPw"
                    style="@style/MyPageEdit"
                    android:layout_marginBottom="0dp"
                    android:paddingRight="48dp"
                    android:hint="현재 비밀번호"
                    android:inputType="textPassword" />

                <ImageButton
                    android:id="@+id/btnShowCurrentPw"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@null"
                    android:contentDescription="비밀번호 보기"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_eye_off" />
            </FrameLayout>

            <TextView
                style="@style/MyPageFormLabel"
                android:text="새 비밀번호" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <EditText
                    android:id="@+id/etNewPw"
                    style="@style/MyPageEdit"
                    android:layout_marginBottom="0dp"
                    android:paddingRight="48dp"
                    android:hint="영문대소문자, 숫자, 특수문자 중 2가지 이상 조합 8~16자"
                    android:inputType="textPassword"
                    android:maxLength="16" />

                <ImageButton
                    android:id="@+id/btnShowNewPw"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@null"
                    android:contentDescription="비밀번호 보기"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_eye_off" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPwRule"
                style="@style/MyPageSubText"
                android:layout_marginBottom="14dp"
                android:text="영문대소문자, 숫자, 특수문자 중 2가지 이상 조합 8~16자\n입력가능 특수문자 ~ ` ! @ # $ % ^ ( ) * _ - = { } [ ] | ; : &lt; &gt; , . ? /"
                android:textSize="11sp" />

            <TextView
                style="@style/MyPageFormLabel"
                android:text="새 비밀번호 확인" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp">

                <EditText
                    android:id="@+id/etNewPwConfirm"
                    style="@style/MyPageEdit"
                    android:layout_marginBottom="0dp"
                    android:paddingRight="48dp"
                    android:hint="새 비밀번호 다시 입력"
                    android:inputType="textPassword"
                    android:maxLength="16" />

                <ImageButton
                    android:id="@+id/btnShowConfirmPw"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@null"
                    android:contentDescription="비밀번호 보기"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_eye_off" />
            </FrameLayout>


        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSave"
        style="@style/MyPageButtonPrimary"
        android:layout_margin="20dp"
        android:text="저장하기" />

</LinearLayout>
