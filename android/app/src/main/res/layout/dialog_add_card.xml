<?xml version="1.0" encoding="utf-8"?>
<!-- 카드 등록 다이얼로그 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="카드 등록"
                android:textColor="#111111"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseSheet"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#111111"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pay_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvPreviewCompany"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="카드사를 선택해주세요"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvPreviewNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="•••• •••• •••• ••••"
                android:textColor="#FFFFFF"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tvPreviewExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="VALID THRU MM/YY"
                android:textColor="#BBBBBB"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            style="@style/MyPageFormLabel"
            android:layout_marginTop="22dp"
            android:text="카드사" />

        <LinearLayout
            android:id="@+id/layoutCompanies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/MyPageFormLabel"
            android:layout_marginTop="18dp"
            android:text="카드번호" />

        <EditText
            android:id="@+id/etCardNumber"
            style="@style/MyPageEdit"
            android:layout_marginBottom="0dp"
            android:hint="0000 0000 0000 0000"
            android:inputType="number"
            android:digits="0123456789 "
            android:maxLength="19" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/MyPageFormLabel"
                    android:text="유효기간" />

                <EditText
                    android:id="@+id/etExpiry"
                    style="@style/MyPageEdit"
                    android:layout_marginBottom="0dp"
                    android:hint="MM/YY"
                    android:inputType="number"
                    android:digits="0123456789/"
                    android:maxLength="5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/MyPageFormLabel"
                    android:text="비밀번호 앞 2자리" />

                <EditText
                    android:id="@+id/etCardPw"
                    style="@style/MyPageEdit"
                    android:layout_marginBottom="0dp"
                    android:hint="••"
                    android:inputType="numberPassword"
                    android:maxLength="2" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="카드 정보는 결제대행사(PG)에 안전하게 보관돼요."
            android:textColor="#999999"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnRegisterCard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_dialog_btn_dark"
            android:gravity="center"
            android:text="등록하기"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
