<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 상세페이지 내용 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 상단바 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="#FFFFFF">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="‹"
                    android:textSize="36sp"
                    android:textColor="#111111" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="상품 상세"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#111111" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

            </LinearLayout>

            <!-- 상품 이미지 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="430dp"
                android:background="#F1F1F1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="상품 이미지"
                    android:textSize="15sp"
                    android:textColor="#AAAAAA" />

            </FrameLayout>

            <!-- 상품 기본 정보 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/textDetailBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="브랜드이름"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="오버핏 반팔 티셔츠"
                    android:textColor="#111111"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/textDetailPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="10,000원"
                    android:textColor="#111111"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="#F5F5F5" />

            <!-- 상품 정보 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="22dp"
                android:paddingEnd="20dp"
                android:paddingBottom="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="상품 정보"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- 옵션 선택 -->
                <!-- 누르면 사이즈 / 색상 선택 창이 열린다 -->
                <LinearLayout
                    android:id="@+id/layoutOptionSelect"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_option_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="옵션"
                        android:textColor="#111111"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textOptionSummary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="사이즈 / 색상을 선택해주세요"
                        android:textColor="#888888"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#888888"
                        android:textSize="22sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="#EEEEEE" />

            <!-- 리뷰 보기 -->
            <TextView
                android:id="@+id/btnReview"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="리뷰 보기  ›"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="#FFFFFF" />

            <!-- 아래 여백 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:background="#FFFFFF" />

        </LinearLayout>

    </ScrollView>

    <!-- 하단 구매 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#FFFFFF"
        android:elevation="12dp">

        <!-- 찜 -->
        <ImageView
            android:id="@+id/btnDetailHeart"
            android:layout_width="56dp"
            android:layout_height="52dp"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_heart_outline"
            android:contentDescription="찜하기"
            android:background="#FFFFFF" />

        <!-- 3D 가상피팅 -->
        <TextView
            android:id="@+id/btnFitting"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="3D 가상피팅"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:background="#EEEEEE" />

        <!-- 장바구니 -->
        <TextView
            android:id="@+id/btnAddCart"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="장바구니 담기"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#111111" />

    </LinearLayout>

</LinearLayout>