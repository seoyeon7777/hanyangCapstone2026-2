<?xml version="1.0" encoding="utf-8"?>
<!-- 사진으로 치수를 재기 직전에 키·몸무게·나이를 받는 창 (BodyInputDialog). 설문에는 쓰이지 않고 치수 추정에만 쓴다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="치수를 재려면 필요합니다"
        android:textColor="#111111"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="입력한 값은 신체 치수를 추정할 때 기준값으로 사용됩니다. 몸무게는 최근에 잰 값을 넣을수록 정확합니다."
        android:textColor="#555555"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/editInputHeight"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#111111"
        android:hint="키 (cm)"
        android:inputType="numberDecimal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="#000000"
        android:textColorHint="#999999"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/editInputWeight"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#111111"
        android:hint="몸무게 (kg)"
        android:inputType="numberDecimal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="#000000"
        android:textColorHint="#999999"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/editInputAge"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#111111"
        android:hint="나이 (만 나이)"
        android:inputType="number"
        android:maxLength="2"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="#000000"
        android:textColorHint="#999999"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnInputCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn_light"
            android:gravity="center"
            android:text="취소"
            android:textColor="#111111"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnInputOk"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn_dark"
            android:gravity="center"
            android:text="확인"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
