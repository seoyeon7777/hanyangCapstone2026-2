<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 이하: 자동 백업에서 앱 데이터 전부 제외 (로그인·계정 기록이 다른 설치로 복원되지 않게) -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
